<dashboard version="1.1" theme="light">
  <label>TA-hwraid Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype hwraid:metrics); series prefixed 'hwraid.'.</description>
  <row>
    <panel type="html">
      <html><![CDATA[<div style="border:1px solid #cc7a00;background:#fff7ea;border-radius:6px;padding:10px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:12px">
<span style="font-weight:700;color:#b35c00">Commercial Use</span>
<span>Commercial or production use of TA-hwraid requires a paid license. Evaluation, personal, and lab use is free. See the BentleyPC Commercial License for full terms.</span>
<a href="https://bentleypc.com/TA-TA-hwraid/" target="_blank" rel="noopener" style="background:#cc7a00;color:#fff;padding:7px 16px;border-radius:5px;font-weight:700;text-decoration:none">Buy License</a>
<a href="https://bentleypc.com/TA-TA-hwraid/LICENSE.html" target="_blank" rel="noopener" style="color:#b35c00;font-weight:600;text-decoration:underline">License &amp; Terms</a>
</div>]]></html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Controller count (per host)</title>
      <chart>
        <search>
          <query>| mstats avg("hwraid.controller_count") as value where index=metrics by host, metric_name span=5m
| rename value as "hwraid.controller_count"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Drive count (per controller)</title>
      <chart>
        <search>
          <query>| mstats avg("hwraid.*_drive_count") as "v*" where index=metrics by metric_name span=5m
| rename v* as "hwraid.*_drive_count"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Failed drives (per controller)</title>
      <chart>
        <search>
          <query>| mstats avg("hwraid.*_failed_drives") as "v*" where index=metrics by metric_name span=5m
| rename v* as "hwraid.*_failed_drives"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Rebuilding drives (per controller)</title>
      <chart>
        <search>
          <query>| mstats avg("hwraid.*_rebuilding") as "v*" where index=metrics by metric_name span=5m
| rename v* as "hwraid.*_rebuilding"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
</dashboard>
