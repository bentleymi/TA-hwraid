{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "Hardware RAID Controller State Add-on (MegaCLI/StorCLI, SSAcli)",
    "id": {
      "group": null,
      "name": "TA-hwraid",
      "version": "1.0.2"
    },
    "author": [{"name":"Michael \"JKat54\" Bentley","email":"michael@bentleypc.com","company":"BentleyPC LLC"}],
    "releaseDate": "11/16/2026",
    "description": "Collects hardware RAID controller state from storcli3/storcli (LSI/MegaRAID), ssacli (HP) or MegaCli, if a controller is present: controller state, drive counts, failed/rebuilding drives and cache/battery state. Emits JSON events to index=main (sourcetype hwraid:status) and hwraid.* metrics to index=metrics (sourcetype hwraid:metrics). Hosts with no hardware RAID report 'absent' with a zero controller count, so fleet coverage stays visible.",
    "classification": {
      "intendedAudience": "IT",
      "categories": ["IT Operations"],
      "developmentStatus": "Production/Latest"
    },
